# Primary LLM Configuration (OpenAI or any OpenAI-compatible provider)
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Base URL if using local models, Azure, Groq, or LiteLLM
# OPENAI_BASE_URL=https://api.openai.com/v1

# Agent Execution Settings
LLM_TEMPERATURE=0.2
LOG_LEVEL=INFO